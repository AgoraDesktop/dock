<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dock.app's Info.plist. A program with an Info.plist beside it IS a bundle, and this one is what the launch path
  and `libagora-launchservices` read: the identifier a window's `set_app_id` is grouped by, and the name a Dock
  tile and the menu bar would show.

  **THE IDENTIFIER IS THE PROJECT'S CONVENTION** (`README.md`, Conventions): `io.github.agoradesktop.NAME`, lower
  case because it is reverse-DNS. It is what `NSWorkspace` sees on this application's windows, and the Dock's own
  controller filters it out of its tile list by exactly this string.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.agoradesktop.dock</string>
	<key>CFBundleName</key>
	<string>Dock</string>
	<key>CFBundleExecutable</key>
	<string>Dock</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@PROJECT_VERSION@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
</dict>
</plist>
